# =============================================================================
# .env.common.example — Secrets shared across all GitHub environments
#
# These go in the repository-level secrets (Settings → Secrets → Actions),
# NOT inside a specific environment. They are available to every workflow.
# =============================================================================

# =============================================================================
# VARIABLES (non-sensitive) — Settings → Environments → production-api → Variables
# These are visible in logs. Use ${{ vars.NAME }} in workflows.
# =============================================================================
AI_PROVIDER=gemini           # or: openai
DB_NAME=replider_db
SMTP_PORT=587
CORS_ALLOWED_ORIGINS=https://app.replider.com,https://replider.com,https://www.replider.com

# =============================================================================
# SECRETS (sensitive) — Settings → Environments → production-api → Secrets
# or repository-level secrets for shared ones (VPS, GHCR).
# =============================================================================

# ── VPS / SSH ─────────────────────────────────────────────────────────────────
VPS_HOST=your-vps-ip-or-hostname
VPS_USER=ubuntu
VPS_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...

# ── GHCR (GitHub Container Registry) ─────────────────────────────────────────
# GHCR_USERNAME = GitHub username of whoever generated the GHCR_TOKEN (not the org name).
# Example: GHCR_USERNAME=<github user that generated the token>
GHCR_USERNAME=your-github-username
# Used by the VPS to pull Docker images from the org's private GHCR.
#
# How to generate (org repo):
#   1. Log in as an org Owner at github.com
#   2. Settings → Developer Settings → Personal Access Tokens → Tokens (classic)
#   3. Generate new token (classic) → scope: read:packages only
#   4. Add the token as secret GHCR_TOKEN in this repository
#
# If the repository is PUBLIC, images are public too — this token is not needed
# and the docker login step in the deploy scripts can be removed.
GHCR_TOKEN=ghp_...

# ── Alerting (SLO) ────────────────────────────────────────────────────────────
# Webhook URLs Alertmanager uses to deliver SLO alerts (US-070). Rendered into
# infra/alertmanager.yml via envsubst at deploy time — see docs/runbook_alerts.md.
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY

# ── GitHub ────────────────────────────────────────────────────────────────────
# Automatically provided by GitHub Actions — no need to set manually.
# Documented here for reference only.
# GITHUB_TOKEN=(automatic)
# github.repository_owner=(automatic)

# ── Custo de IA (BYOK) — production-api ───────────────────────────────────────
# O compose (docker-compose.prod.yml, serviço api) só entrega ao container as
# variáveis que ele lista explicitamente. TODA variável nova precisa de uma
# linha lá E aqui — AI_REQUIRE_BYOK ficou "decidido" e desligado em produção
# por meses porque só existia no código.
#
# true = toda conta roda na PRÓPRIA chave (conta sem chave recebe
# BYOK_KEY_MISSING); a conta da plataforma é isenta. Vars.
AI_REQUIRE_BYOK=true
# Teto mensal de IA para conta sem teto próprio (centavos de BRL; 0 = sem
# teto padrão). Vars.
AI_DEFAULT_MONTHLY_BUDGET_CENTS=5000
# Buscas no Google Places por conta por dia (Places não tem BYOK; é a nossa
# conta que paga). Vars.
PLACES_DAILY_CAP_PER_ACCOUNT=50

# ── Observabilidade / operação — production-api ──────────────────────────────
# Todos opcionais; vazio = recurso desligado.
SENTRY_DSN=                       # secret
ALERT_WEBHOOK_URL=                # secret — Slack/Discord incoming webhook (falhas de IA, backup velho)
OTEL_EXPORTER_OTLP_ENDPOINT=      # var — vazio = tracing no-op
OTEL_SERVICE_NAME=replider-api    # var
LOG_LEVEL=info                    # var — debug|info|warn|error
# RELEASE_SHA é escrito pelo deploy (= API_IMAGE_TAG); não definir à mão.
# Chave JWT ANTERIOR, só para verificação durante uma rotação
# (docs/secret-rotation.md). Vazio fora de rotação. Secret.
JWT_SECRET_PREVIOUS=
# 2FA obrigatório no painel do dono. Default true no compose; só ponha false
# aqui para destravar um operador — e volte. Var.
SUPER_ADMIN_REQUIRE_2FA=true
# Proxies confiáveis para X-Forwarded-For (o nginx do compose). Var.
TRUSTED_PROXIES=
# Token do operador para GET /health/details (e /metrics quando definido).
# `openssl rand -hex 24`. Secret. Vazio = /health/details recusa todo mundo.
METRICS_TOKEN=
# Reativa as ferramentas MCP arquivadas da v1. Var.
MCP_LEGACY_TOOLS=false
# Liga os workers do SaaS self-serve legado (CSAT, digest semanal, reativação,
# win-back, pré-cobrança, metering Stripe/WhatsApp, ladder PIX que SUSPENDE
# conta) e as superfícies que dependem deles (inscrição em cadência, autopilot).
# Desligado desde o pivô SDR — escondido, não apagado.
LEGACY_WORKERS=false

# ── Backup contínuo do Postgres (wal-g, US-F002) ──────────────────────────────
# Vazios = arquivamento DESLIGADO e o container se comporta como o postgres
# padrão. Preencher os dois liga o backup off-site; não precisa de arquivo no
# VPS nem de mount — o container materializa a credencial internamente.
#   WALG_GS_PREFIX=gs://replider-pg-backups/prod
#   WALG_GOOGLE_CREDENTIALS_BASE64=$(base64 -i walg-gcs.json | tr -d '\n')
#
# Deixar WALG_GOOGLE_CREDENTIALS_BASE64 vazio faz o container reusar o
# GOOGLE_CREDENTIALS_BASE64 da API — aí só o bucket precisa ser preenchido.
# Custo dessa escolha: a mesma chave passa a alcançar mídia, Calendar E
# backup. Uma SA dedicada (roles/storage.objectAdmin só no bucket de backup)
# mantém o raio menor; trocar depois é só preencher a variável.
WALG_GS_PREFIX=
WALG_GOOGLE_CREDENTIALS_BASE64=

# ── Antivírus de anexos (OPCIONAL) ───────────────────────────────────────────
# Endereço do daemon ClamAV, ex.: clamav:3310.
#
# VAZIO = sem varredura. Os anexos de e-mail continuam sendo recebidos e
# guardados, mas ficam marcados como "não verificados" — e não verificado NÃO
# é baixável. A ausência do scanner nunca resulta num arquivo servido como se
# estivesse limpo.
#
# Ligar custa ~1,5GB de RAM no host (o banco de assinaturas mora em memória).
# O serviço `clamav` já está no docker-compose.prod.yml.
CLAMD_ADDR=

# ── Idade do domínio do remetente (OPCIONAL) ─────────────────────────────────
# "true" liga a consulta RDAP que sinaliza remetente cujo domínio foi
# registrado há poucos dias — o padrão de domínio de golpe.
#
# Desligado por padrão porque é uma chamada externa no caminho quente do
# inbound. Desligar custa UM sinal entre seis, não a verificação inteira; a
# ausência de resposta nunca é lida como "domínio antigo e confiável".
DOMAIN_AGE_LOOKUP=

# ── Modelo do resumo de thread (OPCIONAL) ────────────────────────────────────
# Resumir é compressão, não escrita: o modelo barato faz igual ao caro, e isso
# roda em toda thread longa que um vendedor abre. Vazio usa o modelo do plano.
AI_MODEL_SUMMARY=

# ── Domínio de rastreio de e-mail (OPCIONAL) ─────────────────────────────────
# URL base dos links rastreados e do pixel de abertura, ex.:
# https://track.suaclinica.com.br
#
# VAZIO = sem rastreio: os links saem intactos e nenhum pixel é inserido.
#
# Deve ser um domínio DO CLIENTE apontando para cá por CNAME. Rastrear a
# partir do nosso domínio funciona tecnicamente e é pior em duas frentes: o
# link não parece do remetente, e a reputação do domínio de rastreio passa a
# ser compartilhada entre todos os clientes.
EMAIL_TRACKING_BASE_URL=
