---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "pt" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("dpa.title") as string}
  description={t("dpa.description") as string}
  lang={lang}
>
  <Header />

  <main class="min-h-screen pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{t("dpa.heading")}</h1>
      <p class="text-white/40 text-sm mb-12">{t("dpa.lastUpdated")}</p>

      <div
        class="prose prose-invert max-w-none space-y-10 text-white/70 leading-relaxed"
      >
        <p>{t("dpa.intro")}</p>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section1.title")}
          </h2>
          <ul class="list-disc list-inside space-y-2">
            {
              (t("dpa.section1.items") as unknown as string[]).map(
                (item: string) => <li>{item}</li>,
              )
            }
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section2.title")}
          </h2>
          <p>{t("dpa.section2.text")}</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section3.title")}
          </h2>
          <p class="mb-4">{t("dpa.section3.text")}</p>
          <ul class="list-disc list-inside space-y-2">
            {
              (t("dpa.section3.items") as unknown as string[]).map(
                (item: string) => <li>{item}</li>,
              )
            }
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section4.title")}
          </h2>
          <ul class="list-disc list-inside space-y-2">
            {
              (t("dpa.section4.items") as unknown as string[]).map(
                (item: string) => <li>{item}</li>,
              )
            }
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section5.title")}
          </h2>
          <ul class="list-disc list-inside space-y-2">
            {
              (t("dpa.section5.items") as unknown as string[]).map(
                (item: string) => <li>{item}</li>,
              )
            }
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section6.title")}
          </h2>
          <p class="mb-4">{t("dpa.section6.text1")}</p>
          <p>{t("dpa.section6.text2")}</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section7.title")}
          </h2>
          <p class="mb-4">{t("dpa.section7.text")}</p>
          <ul class="list-disc list-inside space-y-2">
            {
              (t("dpa.section7.items") as unknown as string[]).map(
                (item: string) => <li>{item}</li>,
              )
            }
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section8.title")}
          </h2>
          <p>{t("dpa.section8.text")}</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section9.title")}
          </h2>
          <p>{t("dpa.section9.text")}</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section10.title")}
          </h2>
          <p>{t("dpa.section10.text")}</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section11.title")}
          </h2>
          <p>{t("dpa.section11.text")}</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">
            {t("dpa.section12.title")}
          </h2>
          <p class="mb-4">{t("dpa.section12.text1")}</p>
          <p class="mb-2">{t("dpa.section12.text2")}</p>
          <p class="font-medium text-white/90">{t("dpa.section12.email")}</p>
        </section>
      </div>
    </div>
  </main>

  <footer class="py-12 border-t border-white/5 bg-black px-6">
    <div
      class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8 text-white/20 text-sm"
    >
      <div>{t("footer.rights")}</div>
      <div class="flex gap-8">
        <a href={`/${lang}/privacy`} class="hover:text-white transition-colors"
          >{t("footer.privacy")}</a
        >
        <a href={`/${lang}/dpa`} class="hover:text-white transition-colors"
          >{t("footer.dpa")}</a
        >
        <a href={`/${lang}/terms`} class="hover:text-white transition-colors"
          >{t("footer.terms")}</a
        >
        <a
          href="mailto:support@replider.com"
          class="hover:text-white transition-colors">{t("footer.contact")}</a
        >
      </div>
    </div>
  </footer>
</Layout>
