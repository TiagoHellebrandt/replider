---
import AnimatedBackground from "./AnimatedBackground";
import { getLangFromUrl } from "../i18n/utils";
import { BOOKING_URL, whatsappLink } from "../data/contact";

interface Props {
  t: {
    title: string;
    highlight: string;
    subtitle: string;
    ctaBook: string;
    ctaWhats: string;
    whatsPrefill: string;
  };
}

const { t } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// Sales-led: a ação primária é a conversa. A página de agenda quando
// configurada; a seção "Vamos conversar" (formulário + WhatsApp) como
// fallback. O secundário vai direto pro WhatsApp com a intro preenchida.
const primaryHref = BOOKING_URL || `/${lang}/#agendar`;
const primaryExternal = BOOKING_URL.length > 0;
const whatsHref = whatsappLink(encodeURIComponent(t.whatsPrefill));
---

<section
  class="relative min-h-[90vh] flex flex-col items-center justify-center overflow-hidden px-4 pt-32 pb-24 bg-[#030303]"
>
  <AnimatedBackground client:only="react" />

  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-sky-500/10 rounded-full blur-[120px] pointer-events-none z-0"
  >
  </div>

  <div class="z-10 text-center max-w-5xl mx-auto px-6 relative">
    <h1
      class="text-4xl md:text-6xl font-bold tracking-tighter mb-8 leading-[1.1] opacity-0 animate-fade-in-up"
    >
      <span
        class="bg-gradient-to-b from-white to-white/40 bg-clip-text text-transparent"
        >{t.title}</span
      >
      <span class="text-sky-400"> {t.highlight}</span>
    </h1>

    <p
      class="text-lg md:text-2xl text-white/40 mb-12 max-w-3xl mx-auto font-light leading-relaxed opacity-0 animate-fade-in-up delay-200"
    >
      {t.subtitle}
    </p>

    <div class="opacity-0 animate-fade-in-up delay-400">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={primaryHref}
          target={primaryExternal ? "_blank" : undefined}
          rel={primaryExternal ? "noopener noreferrer" : undefined}
          data-track="ScheduleDemo"
          class="group relative w-full sm:w-auto px-10 py-5 bg-white text-black font-bold rounded-full hover:scale-105 active:scale-95 transition-all shadow-[0_0_40px_rgba(255,255,255,0.2)] text-lg overflow-hidden z-20 inline-block"
        >
          <span class="relative z-10">{t.ctaBook}</span>
          <div
            class="absolute inset-0 bg-gradient-to-r from-transparent via-black/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
          >
          </div>
        </a>
        <a
          href={whatsHref}
          target="_blank"
          rel="noopener noreferrer"
          data-track="ScheduleDemo"
          data-utm-medium="hero"
          class="w-full sm:w-auto px-10 py-5 bg-white/5 text-white font-bold rounded-full border border-white/15 hover:bg-white/10 hover:scale-105 active:scale-95 transition-all text-lg z-20 inline-block"
        >
          {t.ctaWhats}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-200 {
    animation-delay: 0.2s;
  }
  .delay-400 {
    animation-delay: 0.4s;
  }
</style>
