# Web (Astro) environment variables
#
# Astro exposes only variables prefixed with PUBLIC_ to client-side code.
# Copy this file to `.env` and fill in real values for local development.
# In production these are injected via the deploy workflow (vars.*).

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# When set, Layout.astro loads gtag.js — but ONLY after the visitor accepts
# cookies via the CookieConsent banner (LGPD/GDPR). Leave empty to disable
# analytics entirely (no gtag script is emitted).
PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID for retargeting (numeric, e.g. 1234567890).
# Loaded consent-gated alongside GA4. Fires standard events: PageView,
# ViewContent, Lead (newsletter), InitiateCheckout (Register click).
# Leave empty to disable the pixel.
PUBLIC_META_PIXEL_ID=

# Google Ads conversion/remarketing ID (format: AW-XXXXXXXXX).
# Shares the gtag.js bootstrap with GA4 and is consent-gated. Receives the
# same trackEvent() funnel events. Leave empty to disable.
PUBLIC_GOOGLE_ADS_ID=

# WhatsApp Business Account (WABA) support/sales number used by the floating
# WhatsApp FAB and the "Falar com especialista" CTAs in Pricing. Digits only,
# full international format WITHOUT a leading "+" (e.g. 551140405000). MUST be
# a WABA number, never a personal line. Leave empty to fall back to the
# committed business number in src/data/contact.ts.
PUBLIC_WHATSAPP_NUMBER=
