# Server Configuration
PORT=8080
# HS256 signing key for API access tokens. JWT_SECRET_CURRENT is the canonical
# name; JWT_SECRET is the legacy alias used when JWT_SECRET_CURRENT is unset.
# For a zero-downtime rotation, set JWT_SECRET_CURRENT to the new key and
# JWT_SECRET_PREVIOUS to the old one, wait one token lifespan (24h), then drop
# JWT_SECRET_PREVIOUS. See docs/secret-rotation.md.
JWT_SECRET=your-super-secret-key-change-me
# JWT_SECRET_CURRENT=your-super-secret-key-change-me
# JWT_SECRET_PREVIOUS=
APP_BASE_URL=http://localhost:8080
# MCP / OAuth (integração com Claude). Em produção:
# API_PUBLIC_URL=https://api.replider.com (issuer OAuth — rotas /oauth e /mcp vivem aqui)
# DASHBOARD_URL=https://app.replider.com (redirects de checkout gerados via MCP)
# Ambos caem para APP_BASE_URL quando não definidos (ok em dev local).
# API_PUBLIC_URL=
# DASHBOARD_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Log verbosity: debug | info | warn | error. Default info (prod-safe).
# Bump to debug temporarily to surface verbose diagnostics (US-029).
LOG_LEVEL=info

# ngrok (local dev only) — get your token at https://dashboard.ngrok.com/get-started/your-authtoken
# When set, the entrypoint will start an ngrok tunnel and auto-update APP_BASE_URL.
# Telegram webhooks will be auto-registered using this URL.
NGROK_AUTHTOKEN=

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=replider
DB_PASSWORD=secret
DB_NAME=replider_db
DB_SSLMODE=disable
# Connection pool sizing (US-063). Defaults: 25 max open, 5 idle floor,
# 30m max connection lifetime, 5m max idle time. Tune for prod load.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
# true = every account must bring its own AI key (sales-led cost model);
# the platform account stays on the env key. Default off.
AI_REQUIRE_BYOK=
# true = the overnight draft pass submits through the provider's Batch API
# (50% of the token price, collected before morning); any submit failure
# falls back to the synchronous pass. Default off.
AI_BATCH_DRAFTS=

# WhatsApp Business Cloud API (Tech Provider / BSP)
# App ID and App Secret from Meta for Developers → Your App → Settings → Basic
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_APP_SECRET=your-meta-app-secret
# Facebook Login (POST /auth/meta) app-binding. Proves an inbound access_token
# was minted for OUR app (via /debug_token) — without it any valid FB token
# from any app grants a session. Defaults to WHATSAPP_APP_ID/SECRET (same Meta
# app); set only when Facebook Login lives on a different app.
META_APP_ID=
META_APP_SECRET=
# A random string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=replider-whatsapp-verify
# System User permanent access token — generated in Meta Business Manager → System Users
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token

# Instagram DM webhooks: app secret that signs X-Hub-Signature-256 on inbound
# IG payloads. Set to the Meta app secret of the app whose webhook subscription
# points at /v1/webhooks/{channel_token} (equals WHATSAPP_APP_SECRET when both
# products share one Meta app). Empty = signature validation skipped with a WARN.
# Per-channel override: `app_secret` key inside the channel config.
INSTAGRAM_APP_SECRET=

# Stripe Billing Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
# AbacatePay (Brazilian PIX + card gateway, US-abacate). Empty disables the
# whole AbacatePay path — BRL accounts then check out via Stripe. The
# transparent checkout routes BRL→AbacatePay (PIX inline + card hosted, Elo)
# and non-BRL→Stripe. See docs/abacatepay.md.
ABACATEPAY_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Usage-based metered overage prices (US-168). Each is a `metered` recurring
# Stripe Price (aggregate_usage=last_during_period) added as an extra
# subscription line item. Empty = that meter is not billed. See docs/billing.md.
STRIPE_METERED_PRICE_EXTRA_CONVERSATION=
STRIPE_METERED_PRICE_EXTRA_TOKEN=
STRIPE_METERED_PRICE_EXTRA_AGENT=

# Google Cloud (single service account for GCS, Calendar, and future Google APIs)
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_CREDENTIALS_BASE64=your-base64-encoded-service-account-json

# "Conectar Google Calendar" OAuth flow (per-account calendar link).
# The client secret of the SAME OAuth web client as GOOGLE_CLIENT_ID
# (add API_PUBLIC_URL/v1/oauth/google-calendar/callback to its
# Authorized redirect URIs). The id_token login flow never uses this;
# only the server-side code exchange does. Empty disables the connect
# feature; the service account above remains the booking fallback.
GOOGLE_CLIENT_SECRET=

# Google Places API (New) — outbound-sales prospecting search (US-021).
# A simple API key (NOT the service account), restricted to the Places API (New).
# Create at: Google Cloud Console → APIs & Services → Credentials → API key.
# Empty disables prospecting search (the adapter returns a clear "unconfigured" error).
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# SMTP Email Configuration (Password Recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@replider.com

# Bulk email provider (hybrid sending, 2026-08-25). Batch approvals go out via
# Resend once the customer's domain is registered+verified there; empty key =
# volume sending unavailable (individual approvals unaffected).
RESEND_API_KEY=

# Social Auth (OAuth2)
# Google OAuth2 Client — used by Flutter app (client-side login), not the API server.
# Create at: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# The API only validates the id_token received from the client — no server-side redirect needed.
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Cloudflare Turnstile (signup anti-abuse — US-054)
# Secret key from the Turnstile dashboard. When set, the public signup
# endpoint requires a valid captcha token after 3 attempts/hour from one IP.
# Leave blank to disable the captcha challenge (signup then relies only on the
# US-053 5/hour-per-IP rate limit). The matching site key lives in the web app.
TURNSTILE_SECRET_KEY=

# Maximum inbound request body size in bytes (US-192). Requests larger than this
# are rejected with HTTP 413. Defaults to 10 MiB (10485760). Set to 0 to disable.
MAX_REQUEST_BODY_BYTES=10485760

# TOTP at-rest encryption (2FA — US-076)
# 32-byte AES-256-GCM key-encryption key (64 hex chars) that seals users'
# TOTP shared secrets in the database. Generate with: openssl rand -hex 32
# Keep it separate from BYOK_ENCRYPTION_KEY (independent blast radius) and
# stable across deploys — rotating it makes existing enrolled secrets
# undecryptable (users must re-run 2FA Setup). Leave blank in dev to disable
# 2FA enrollment (Setup is rejected rather than storing a plaintext seed).
TOTP_KEK=

# BYOK provider-key at-rest encryption (contract plans)
# 32-byte AES-256-GCM key (64 hex chars) that seals each contract account's
# OpenAI/Gemini API keys in the database. Generate with: openssl rand -hex 32
# Separate from TOTP_KEK (independent blast radius) and stable across deploys —
# rotating it makes existing stored provider keys undecryptable (admins must
# re-enter them). Leave blank in dev to disable BYOK writes (saving a key is
# refused with BYOK_CIPHER_UNCONFIGURED rather than storing plaintext).
BYOK_ENCRYPTION_KEY=

# Redis (Caching & Background Jobs)
# In production this is hardcoded to the internal Docker service (redis://redis:6379).
# For local dev, point to your local Redis instance.
REDIS_URL=redis://localhost:6379

# Web Push Notifications (VAPID)
# Generate a keypair once and keep it stable across deploys — rotating it
# invalidates every browser subscription. Easiest generator:
#   npx web-push generate-vapid-keys
# Leave blank to disable push; the API will log-only and fan out to zero subs.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:ops@replider.com

# OpenTelemetry distributed tracing (US-066 — see docs/observability.md)
# OTLP/HTTP collector base. Empty = tracing disabled (no-op, zero cost).
# Examples: "otel-collector:4318" (plain HTTP) or "https://otlp.example.com" (TLS).
OTEL_EXPORTER_OTLP_ENDPOINT=
# service.name reported on every span.
OTEL_SERVICE_NAME=replider-api

# Sentry error tracking (US-074). Empty = disabled (no-op, no network calls).
# DSN from the Sentry project settings. PII (auth headers, cookies, request
# bodies, phone/email/cpf tags, user email/IP) is scrubbed before send.
SENTRY_DSN=
# Optional release identifier surfaced in Sentry (defaults to RELEASE_SHA).
RELEASE_SHA=

# Vendedores (commissioned sellers, PRD v3 — US-001)
# Account id of the Replider-owned platform account whose attendants are the
# commissioned sellers. Gates every seller/CRM/commission feature (B/C layers):
# leave blank to disable them entirely (dev, self-hosted). Seller routes 404
# outside this account.
PLATFORM_ACCOUNT_ID=

# Canal interno de CS (US-004): how long an internal-support reply can sit
# unread before the single fallback email fires. Go duration; default 4h.
SUPPORT_UNREAD_EMAIL_AFTER=4h

# Marketing-site origin (landing). Hosts the canonical seller prospecting
# link: {WEB_BASE_URL}/register?ref=SELLERCODE (US-003).
WEB_BASE_URL=https://replider.com

# ── Antivírus de anexos (OPCIONAL) ───────────────────────────────────────────
# Endereço do daemon ClamAV, ex.: clamav:3310.
#
# VAZIO = sem varredura. Os anexos de e-mail continuam sendo recebidos e
# guardados, mas ficam marcados como "não verificados" — e não verificado NÃO
# é baixável. A ausência do scanner nunca resulta num arquivo servido como se
# estivesse limpo.
#
# Ligar custa ~1,5GB de RAM no host (o banco de assinaturas mora em memória).
# O serviço `clamav` já está no docker-compose.prod.yml.
CLAMD_ADDR=

# ── Import de produtos por PDF de folheto (OPCIONAL) ─────────────────────────
# Limites do upload do folheto do fabricante. O PDF inteiro passa por um
# modelo multimodal (na chave BYOK da conta), então o teto de páginas é um
# controle de custo, não uma regra de formato. Exceder qualquer um dos dois
# devolve erro claro dizendo o limite. SEM antivírus (CLAMD_ADDR vazio) a
# rota RECUSA o upload — não existe modo degradado sem scan.
PRODUCT_PDF_IMPORT_MAX_MB=10
PRODUCT_PDF_IMPORT_MAX_PAGES=40

# ── Aquecimento de caixa de e-mail (OPCIONAL) ────────────────────────────────
# A guarda de aquecimento FALHA FECHADA: caixa sem warmup_started_at (nunca
# verificada) não envia prospecção fria. Durante a rampa o limite diário
# cresce do valor inicial (5) até o teto abaixo. Valores zero/ inválidos
# mantêm os defaults (21 dias, 25/dia) — configuração errada nunca desliga a
# proteção.
EMAIL_WARMUP_RAMP_DAYS=21
EMAIL_WARMUP_DAILY_CAP=25

# ── Cadastro público (fluxo sales-led) ───────────────────────────────────────
# false = a porta pública fecha (senha, Google e Meta) e conta nova só nasce
# com convite de uso único emitido no painel do dono (/owner → convites) ou
# criada direto por lá. Default true para um deploy novo não se trancar fora.
# Em produção do modelo sales-led: false. Lembre da linha correspondente no
# docker-compose.prod.yml (environment explícito).
REGISTRATION_ENABLED=false

# ── Idade do domínio do remetente (OPCIONAL) ─────────────────────────────────
# "true" liga a consulta RDAP que sinaliza remetente cujo domínio foi
# registrado há poucos dias — o padrão de domínio de golpe.
#
# Desligado por padrão porque é uma chamada externa no caminho quente do
# inbound. Desligar custa UM sinal entre seis, não a verificação inteira; a
# ausência de resposta nunca é lida como "domínio antigo e confiável".
DOMAIN_AGE_LOOKUP=

# ── Modelo do resumo de thread (OPCIONAL) ────────────────────────────────────
# Resumir é compressão, não escrita: o modelo barato faz igual ao caro, e isso
# roda em toda thread longa que um vendedor abre. Vazio usa o modelo do plano.
AI_MODEL_SUMMARY=

# ── Domínio de rastreio de e-mail (OPCIONAL) ─────────────────────────────────
# URL base dos links rastreados e do pixel de abertura, ex.:
# https://track.suaclinica.com.br
#
# VAZIO = sem rastreio: os links saem intactos e nenhum pixel é inserido.
#
# Deve ser um domínio DO CLIENTE apontando para cá por CNAME. Rastrear a
# partir do nosso domínio funciona tecnicamente e é pior em duas frentes: o
# link não parece do remetente, e a reputação do domínio de rastreio passa a
# ser compartilhada entre todos os clientes.
EMAIL_TRACKING_BASE_URL=
